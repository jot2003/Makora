# Azure Speech Service (realtime STT + diarization)
AZURE_SPEECH_KEY=your-speech-key
AZURE_SPEECH_REGION=eastus

# Azure OpenAI — primary model
AZURE_OPENAI_KEY=your-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_FAST_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure OpenAI — additional models (optional, increment index)
# AZURE_OPENAI_KEY_2=
# AZURE_OPENAI_ENDPOINT_2=
# AZURE_OPENAI_DEPLOYMENT_2=
# AZURE_OPENAI_LABEL_2=

# Azure Translator (optional)
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=

# Auth
JWT_SECRET=change-me-in-production
JWT_EXPIRE_HOURS=72

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
OAUTH_REDIRECT_BASE=http://localhost:8000

# HuggingFace (speaker diarization model)
HF_TOKEN=

# CORS — comma-separated origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
